  "reviews": [
    {
      "game": "SnowRunner",
      "game_image": "https://gaming-cdn.com/images/products/8798/450x258/snowrunner-pc-mac-steam-cover.jpg?v=1788696000",
      "game_url": "https://www.instant-gaming.com/en/8798-buy-snowrunner-pc-mac-steam/",
      "user": "Ildaran",
      "avatar": "https://gaming-cdn.com/themes/igv2/images/avatar2.svg",
      "sentiment": "dislike",
      "content": "Prise en main horrible.\n\n\n\nLes missions ne sont pas bien expliquées, on ne sait pas par ou commencer.\n\n\n\nPas de progression dans la difficulté, il n' y a pas un début \"facile\" pour apprendre toutes les mécaniques du jeu."
    },
    {
      "game": "Sunset Overdrive",
      "game_image": "https://gaming-cdn.com/images/products/608/450x258/sunset-overdrive-pc-game-steam-cover.jpg?v=1788696000",
      "game_url": "https://www.instant-gaming.com/en/608-buy-sunset-overdrive-pc-game-steam/",
      "user": "Filaraki",
      "avatar": "https://gaming-cdn.com/images/avatars/27591431-1788642190.jpg",
      "sentiment": "like",
      "content": "Sunset Overdrive (developed by Insomniac Games) is a fast-paced, irreverent open-world action game that fuses the fluid movement of Jet Set Radio with the wacky, explosive arsenal of Ratchet & Clank. Set in a vibrant post-apocalyptic city over-run by energy-drink mutants, its gameplay revolves entirely around maintaining momentum by grinding, wall-running, and bouncing across the skyline while firing outrageous weapons\n\n\n\nVerdict: 8/10 — A cult-classic action sandbox that delivers pure, unadulterated fun. Just grab a gamepad to play it on PC"
    },
    {
      "game": "LEGO The Hobbit",
      "game_image": "https://gaming-cdn.com/images/products/345/450x258/lego-the-hobbit-pc-game-steam-cover.jpg?v=1788696000",
      "game_url": "https://www.instant-gaming.com/en/345-buy-lego-the-hobbit-pc-game-steam/",
      "user": "Filaraki",
      "avatar": "https://gaming-cdn.com/images/avatars/27591431-1788642190.jpg",
      "sentiment": "like",
      "content": "LEGO The Hobbit builds on the open-world formula of LEGO The Lord of the Rings with polished mechanics like dwarf \"buddy-up\" attacks and resource crafting. However, it is fundamentally held back by a major structural flaw: it only covers the first two films (An Unexpected Journey and The Desolation of Smaug). The planned DLC for the third film was canceled, leaving the narrative permanently unfinished\n\n\n\nVerdict: 6.5/10 — Fun gameplay and detailed environments, but the permanent lack of the third movie's story makes it hard to recommend over LEGO Lord of the Rings."
    },
    {
      "game": "LEGO Lord of the Rings",
      "game_image": "https://gaming-cdn.com/images/products/731/450x258/lego-lord-of-the-rings-pc-game-steam-cover.jpg?v=1788696000",
      "game_url": "https://www.instant-gaming.com/en/731-buy-lego-lord-of-the-rings-pc-game-steam/",
      "user": "Filaraki",
      "avatar": "https://gaming-cdn.com/images/avatars/27591431-1788642190.jpg",
      "sentiment": "like",
      "content": "LEGO The Lord of the Rings stands out as one of Traveller's Tales' finest entries in the LEGO franchise. It translates Peter Jackson’s iconic cinematic trilogy into a charming, brick-built open world while maintaining its signature family-friendly humor\n\n\n\nVerdict: 8.5/10 — A must-play for Middle-earth fans and co-op gamers looking for a comfortable, nostalgic playthrough"
    }
