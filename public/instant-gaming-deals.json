  "reviews": [
    {
      "game": "Alien: Isolation",
      "game_image": "https://gaming-cdn.com/images/products/305/450x258/alien-isolation-pc-mac-game-steam-cover.jpg?v=1788393600",
      "game_url": "https://www.instant-gaming.com/en/305-buy-alien-isolation-pc-mac-game-steam/",
      "user": "gustmaci",
      "avatar": "https://gaming-cdn.com/images/avatars/25830991-1738637198.jpg",
      "sentiment": "like",
      "content": "SO GOOD, this game is PEAK, i love how intense some moments can be when you are with the alien, and the story is cool to follow and hear, and you will have some fear through your journey in this spaceship, i like the protagonist, i liked the mechanics, the weapons and the alien AI is pretty cool, not that smart as people say it is, but really smarter than most."
    },
    {
      "game": "Aliens: Dark Descent",
      "game_image": "https://gaming-cdn.com/images/products/19421/450x258/aliens-dark-descent-pc-game-steam-europe-cover.jpg?v=1788393600",
      "game_url": "https://www.instant-gaming.com/en/19421-buy-aliens-dark-descent-pc-game-steam-europe/",
      "user": "gamer-6588b5",
      "avatar": "https://gaming-cdn.com/themes/igv2/images/avatar2.svg",
      "sentiment": "like",
      "content": "Really enjoyed this. Great atmosphere, genuinely tense gameplay and the Xenomorphs are absolutely terrifying when things start going wrong.\n\n\n\nThe squad management and resource system work really well, and every mission feels like it could go sideways at any moment.\n\n\n\nIf you're an Aliens fan and like tactical games, definitely worth playing."
    },
    {
      "game": "Dying Light Definitive Edition",
      "game_image": "https://gaming-cdn.com/images/products/8918/450x258/dying-light-definitive-edition-pc-mac-steam-cover.jpg?v=1788393600",
      "game_url": "https://www.instant-gaming.com/en/8918-buy-dying-light-definitive-edition-pc-mac-steam/",
      "user": "CRoMa_Briel",
      "avatar": "https://gaming-cdn.com/images/avatars/6276365-1585749359.jpg",
      "sentiment": "like",
      "content": "Great value pack! Gives accès to Dying Light and Dying Light: The Following. Both really good zombie survival games in open worlds. Fighting, crafting, weapons of choice and more! Really fun to play alone for the story or with friends."
    },
    {
      "game": "007 First Light",
      "game_image": "https://gaming-cdn.com/images/products/22735/450x258/007-first-light-pc-steam-cover.jpg?v=1788393600",
      "game_url": "https://www.instant-gaming.com/en/22735-buy-007-first-light-pc-steam/",
      "user": "RedSamuraii",
      "avatar": "https://gaming-cdn.com/images/avatars/31223993-1778521817.jpg",
      "sentiment": "like",
      "content": "Just finished 007 :First Light, and honestly, it was a great James Bond experience. The story was engaging, the action felt smooth, and the game captured that classic Bond feeling with stylish missions, gadgets, stealth, and great set pieces. The characters were interesting, and I really enjoyed seeing a younger Bond develop throughout the story. It definitely has some flaws, but I think the game has a lot of potential if the developers continue the story with a sequel. I’d love to see them build on the first game, improve the mechanics, and give us an even bigger Bond adventure. Overall, a solid experience with plenty of room to grow. 8/10."
    }
