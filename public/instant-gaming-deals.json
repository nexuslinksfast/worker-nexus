  "reviews": [
    {
      "game": "Runaway, A Road Adventure",
      "game_image": "https://gaming-cdn.com/images/products/8727/450x258/runaway-a-road-adventure-pc-game-steam-cover.jpg?v=1793854800",
      "game_url": "https://www.instant-gaming.com/en/8727-buy-runaway-a-road-adventure-pc-game-steam/",
      "user": "SambaL",
      "avatar": "https://gaming-cdn.com/images/avatars/27742514-1746025891.jpg",
      "sentiment": "dislike",
      "content": "As a huge fan of basically any Lucas Arts era and Double fine remastered point & click adventure games for their humor and animation, the Runaway series made me loose hope in the genre. Terrible, just terrible."
    },
    {
      "game": "Eriksholm: The Stolen Dream",
      "game_image": "https://gaming-cdn.com/images/products/19764/450x258/eriksholm-the-stolen-dream-pc-steam-cover.jpg?v=1793854800",
      "game_url": "https://www.instant-gaming.com/en/19764-buy-eriksholm-the-stolen-dream-pc-steam/",
      "user": "SambaL",
      "avatar": "https://gaming-cdn.com/images/avatars/27742514-1746025891.jpg",
      "sentiment": "like",
      "content": "Only played the demo on Steam, which is pretty substantial by the way, and as far as I'm concerned this is a real gem. Not only does it look phenomenal, both in cutscenes and in game. It reminded me of the Commandos games from back in the day and how the photorealistic environments blew me away back then. The gameplay reminded me of it as well in a way, though it is less strategic based and more focussed on sneaking your way past guards across stunning setpieces to reach the end of a level.\n\n\n\nThere is a lot of optional collectables to read through but I really didn't mind as the setting and the story are quite interesting. \n\n\n\nA game I can strongly recommend."
    },
    {
      "game": "The Wolf Among Us",
      "game_image": "https://gaming-cdn.com/images/products/1407/450x258/the-wolf-among-us-pc-mac-game-steam-cover.jpg?v=1793854800",
      "game_url": "https://www.instant-gaming.com/en/1407-buy-the-wolf-among-us-pc-mac-game-steam/",
      "user": "Ghostbody",
      "avatar": "https://gaming-cdn.com/themes/igv2/images/avatar2.svg",
      "sentiment": "like",
      "content": "An absolute classic. The comic it's based on is excellent and this is probably the best game that Telltale made of their point and click era, especially as of the original team before the reformation under Skybound."
    },
    {
      "game": "WARDOGS Supporter Edition",
      "game_image": "https://gaming-cdn.com/images/products/23831/450x258/wardogs-supporter-edition-pc-steam-cover.jpg?v=1793854800",
      "game_url": "https://www.instant-gaming.com/en/23831-buy-wardogs-supporter-edition-pc-steam/",
      "user": "Luis_Chalaca",
      "avatar": "https://gaming-cdn.com/images/avatars/3778843-1788825048.jpg",
      "sentiment": "like",
      "content": "WARDOGS offers an interesting experience for players who enjoy military games, tactical action, and teamwork. The concept is appealing and has great potential to provide hours of entertainment, especially when playing with friends.\n\n\n\nThere are still some areas that could be improved, but overall, the game shows a lot of promise. I hope the developers continue to support and improve it with future updates."
    }
