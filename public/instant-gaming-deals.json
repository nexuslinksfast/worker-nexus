    {
      "game": "WARDOGS",
      "game_image": "https://gaming-cdn.com/images/products/21740/450x258/wardogs-pc-steam-cover.jpg?v=1791781200",
      "game_url": "https://www.instant-gaming.com/en/21740-buy-wardogs-pc-steam/",
      "user": "gamer-a8ba7c1",
      "avatar": "https://gaming-cdn.com/themes/igv2/images/avatar2.svg",
