      "game": "Minecraft: Java & Bedrock Edition Ultimate Collection",
      "game_image": "https://gaming-cdn.com/images/products/22260/450x258/minecraft-java-and-bedrock-edition-ultimate-collection-pc-microsoft-store-cover.jpg?v=1790218800",
